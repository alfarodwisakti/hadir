```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
target/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py.class
.Python
env/
venv/
.venv/
.env
.env.local
.env.*
.venv/
.ENV
.python-version
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon?
apidoc/

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Coverage directory used by tools like istanbul
coverage/
lib-cov/

# Temporary folders
tmp/
temp/

# Environment variables
.env
.env.local
.env.*

# Compiled binary files
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.a
*.obj
*.out

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```